# Mail Sentinel Configuration
PROJECT_NAME="Mail Sentinel"
TAGLINE="Detect the Threat. Protect the Inbox."
ENVIRONMENT=development
DEBUG=False

# Database (PostgreSQL URL; falls back automatically to SQLite if PostgreSQL is offline or unconfigured)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mail_sentinel

# Threat Intelligence Feed API Keys (Optional - Mail Sentinel functions locally without keys)
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
PHISHTANK_API_KEY=
ABUSEIPDB_API_KEY=
